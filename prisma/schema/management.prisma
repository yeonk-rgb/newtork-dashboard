// 경영지원팀 스키마 (담당: 경영지원팀)
// - 금액은 모두 BigInt (원 단위 정수)
// - *ById 는 지금은 userId 문자열만 저장. 3단계 인증에서 User 관계 연결 예정
// - 테이블명은 mgmt_ 접두사

/// 입력 상태: 임시저장 / 확정 (대시보드에는 CONFIRMED만 반영)
enum MgmtEntryStatus {
  DRAFT
  CONFIRMED
}

/// 비용 성격: 고정비 / 변동비 (BEP 계산용)
enum MgmtCostType {
  FIXED
  VARIABLE
}

/// 연간 목표
model AnnualTarget {
  id            String  @id @default(cuid())
  year          Int     @unique
  /// 연간 목표매출액
  revenueTarget BigInt
  /// 분기별 목표(선택). 비어 있는 분기 = (연간 − 입력한 분기 합) ÷ 빈 분기 수, 나머지는 마지막 빈 분기에 더함
  q1Target      BigInt?
  q2Target      BigInt?
  q3Target      BigInt?
  q4Target      BigInt?

  /// 마지막으로 엑셀 업로드로 저장된 경우 그 업로드 id (외부 AI 분석 차단 판단용, 05-19)
  uploadId String?

  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("mgmt_annual_target")
}

/// 월별 재무 입력 (연도+월 유일)
model MonthlyFinance {
  id    String @id @default(cuid())
  year  Int
  /// 1~12 (애플리케이션에서 Zod로 검증)
  month Int

  /// 제품 매출액
  productSales     BigInt @default(0)
  /// 상품 매출액
  goodsSales       BigInt @default(0)
  /// 용역 매출액
  serviceSales     BigInt @default(0)
  /// 상품 매입액
  goodsPurchase    BigInt @default(0)
  /// 원재료 매입액
  materialPurchase BigInt @default(0)
  /// 경비 지출액
  operatingExpense BigInt @default(0)

  status      MgmtEntryStatus @default(DRAFT)
  confirmedAt DateTime?

  /// 마지막으로 엑셀 업로드로 저장된 경우 그 업로드 id (외부 AI 분석 차단 판단용, 05-19)
  uploadId String?

  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  otherExpenses OtherExpense[]

  @@unique([year, month])
  @@map("mgmt_monthly_finance")
}

/// "그 외 지출" 항목 (관리자가 추가·비활성화)
model ExpenseCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  /// 고정비/변동비 — BEP 계산 시 사용, 지금은 비워 둘 수 있음
  costType  MgmtCostType?
  /// false면 새 입력 화면에서 숨김 (과거 데이터는 유지)
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  otherExpenses OtherExpense[]

  @@map("mgmt_expense_category")
}

/// 월별 "그 외 지출" 금액
model OtherExpense {
  id               String          @id @default(cuid())
  monthlyFinanceId String
  monthlyFinance   MonthlyFinance  @relation(fields: [monthlyFinanceId], references: [id], onDelete: Cascade)
  categoryId       String
  /// 사용 중인 항목은 삭제 불가 (비활성화만 가능)
  category         ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount           BigInt

  @@unique([monthlyFinanceId, categoryId])
  @@index([categoryId])
  @@map("mgmt_other_expense")
}

/// 미수금 (거래 건별)
model Receivable {
  id           String    @id @default(cuid())
  customerName String
  /// 발생일
  occurredOn   DateTime  @db.Date
  amount       BigInt
  isCollected  Boolean   @default(false)
  /// 수금일
  collectedOn  DateTime? @db.Date
  /// 수금 예정일 (자금수지 예측용)
  dueOn        DateTime? @db.Date
  note         String?

  /// 숨김(삭제 대신) 일시 — 값이 있으면 목록·대시보드·통계에서 모두 제외, 팀장이 복구 가능
  deletedAt   DateTime?
  deletedById String?

  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isCollected, occurredOn])
  @@index([deletedAt])
  @@map("mgmt_receivable")
}

/// AI 분석 코멘트 (분기별). 다시 분석하면 행을 추가하고 화면은 최신 1건만 보여준다
model AiComment {
  id            String @id @default(cuid())
  year          Int
  /// 1~4 (애플리케이션에서 Zod로 검증)
  quarter       Int
  /// AI에 보낸 집계값 (거래처명·건별 내역 없음)
  inputSummary  Json
  /// { summary, weaknesses[], improvements[] }
  result        Json
  /// inputSummary 의 SHA-256 — 지금 데이터로 만든 값과 다르면 "최신 아님" 안내
  inputHash     String
  /// 실제 응답한 모델 (fallback 시 다른 모델일 수 있음, 모의 응답은 "mock")
  model         String
  promptVersion String

  createdById String
  createdAt   DateTime @default(now())

  @@index([year, quarter, createdAt])
  @@map("mgmt_ai_comment")
}

/// 엑셀 업로드 이력 (누가, 언제, 어떤 파일, 몇 행)
model DataUpload {
  id        String @id @default(cuid())
  /// 올린 파일 이름 목록
  fileNames Json
  /// 시트별 결과 [{ fileName, sheetName, kind, savedRows, excludedRows }]
  sheets    Json
  /// 저장한 행 수 합계
  savedRows Int

  createdById String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("mgmt_data_upload")
}

/// 채권·채무 관리 구분 (경영지원_관리.xlsx 블록 4개)
enum MgmtLedgerKind {
  /// 외상매출금
  AR
  /// 외상매입금
  AP
  /// 미지급비용-직원
  ACCRUED_STAFF
  /// 미지급비용-업체
  ACCRUED_VENDOR
}

/// 외상매출금 상태 (엑셀 F열 그룹)
enum MgmtArStatus {
  /// 장기미수
  LONG_OVERDUE
  /// 당월수금완료
  COLLECTED
  /// 당월수금예정
  SCHEDULED
}

/// 외상매입금 매입유형
enum MgmtPurchaseType {
  /// 상품매입
  GOODS
  /// 원재료매입
  RAW_MATERIAL
}

/// 미지급비용-업체 비용유형
enum MgmtVendorExpenseType {
  /// 광고선전비
  ADVERTISING
  /// 접대비
  ENTERTAINMENT
  /// 기타
  OTHER
}

/// 채권·채무 (기준년월별 거래처 잔액 — 엑셀 양식 그대로). 구분마다 쓰는 칸이 다르며 검증은 ledger/schemas.ts
/// 기존 미수금(mgmt_receivable, 건별)과는 별개 — 대시보드 미연결 (05-22번 정리 전까지)
model LedgerEntry {
  id           String                 @id @default(cuid())
  year         Int
  month        Int
  kind         MgmtLedgerKind
  /// 외상매출금만 (필수)
  arStatus     MgmtArStatus?
  /// 외상매입금만 (필수)
  purchaseType MgmtPurchaseType?
  /// 미지급비용-업체만 (필수)
  expenseType  MgmtVendorExpenseType?
  /// 미지급비용-업체만 의미 있음
  autoTransfer Boolean                @default(false)
  /// 외상매출금만, 숫자 10자리 문자열 (앞자리 0 유지)
  partnerCode  String?
  partnerName  String
  amount       BigInt
  note         String?
  /// 수금(지급) 예정일
  dueOn        DateTime?              @db.Date
  /// 수금(지급) 완료일 — 외상매출금 당월수금완료는 필수
  settledOn    DateTime?              @db.Date

  /// 숨김(삭제 대신) — 조회할 때는 반드시 deletedAt: null
  deletedAt   DateTime?
  deletedById String?

  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year, month, kind])
  @@index([deletedAt])
  @@map("mgmt_ledger_entry")
}
