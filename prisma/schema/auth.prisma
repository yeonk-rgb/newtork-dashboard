// 사용자·로그인 세션 (담당: 경영지원팀 — 공통 인증, 모든 팀이 같이 쓴다)
// 테이블은 auth_ 접두사. 권한 규칙은 src/shared/auth/can.ts, 화면은 /admin (관리자 설정)

/// 역할 — 관리자(대표) / 경영지원팀 / 팀장 / 팀원
enum AuthRole {
  ADMIN
  MANAGEMENT
  LEADER
  MEMBER
}

/// 열람 범위·수정 권한 체크박스 대상 팀 (경영지원·메인은 역할로 정해지므로 없음)
enum AuthTeam {
  production
  service
}

model AuthUser {
  id                 String     @id @default(cuid())
  /// 로그인 아이디 (소문자·숫자·밑줄)
  loginId            String     @unique
  name               String
  role               AuthRole
  /// 팀장·팀원만 사용 (관리자·경영지원팀은 빈 배열 = "전체")
  viewTeams          AuthTeam[] @default([])
  /// 팀장만 사용, viewTeams 의 부분집합
  editTeams          AuthTeam[] @default([])
  /// scrypt$N$r$p$salt$hash (src/shared/auth/password.ts)
  passwordHash       String
  /// 첫 로그인 전·초기화 후 = true → 로그인하면 비밀번호 변경 화면으로
  mustChangePassword Boolean    @default(true)
  passwordChangedAt  DateTime?
  failedLoginCount   Int        @default(0)
  /// 연속 5회 실패 시 10분 잠금
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  /// 퇴사자 (삭제 대신 비활성화)
  deactivatedAt      DateTime?
  deactivatedById    String?
  createdById        String?
  updatedById        String?
  createdAt          DateTime   @default(now())
  /// 관리자 화면 동시 수정 확인용
  updatedAt          DateTime   @updatedAt

  sessions AuthSession[]

  @@map("auth_user")
}

model AuthSession {
  /// 쿠키 토큰의 SHA-256 (토큰 원문은 DB에 저장하지 않는다)
  id        String   @id
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@map("auth_session")
}
