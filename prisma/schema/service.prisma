// 서비스팀 스키마 — 친구 저장소(lyjradiant-max/newtalk-korea-system) backend/service/models.py 를 옮김 (2026-11-03 통합 1단계)
// - 테이블명은 svc_ 접두사, *ById 는 외래키 없는 사용자 id 문자열 (docs/integration-notes.md 8번)
// - 출장보고서 1건 = 출장 1건, 기간 기준 = 출장 시작일 (specs/07 S0)
// - 사람 이름(작성자·동행자·승인자)은 PDF처럼 글자로 저장 (앱 계정과 연결하지 않음)
// - 통합 3단계(2026-11-03): 부품·출장지·출장지별 가격·부품 사용·첨부를 옮김 (docs/service-migration.md)
// - 삭제 대신 숨김(deletedAt) — 조회할 때는 반드시 deletedAt: null

/// 비용청구 유무 — null = 미입력 (유상 비율에서 뺌)
enum SvcBilling {
  PAID
  FREE
}

/// 출장보고서
model SvcReport {
  id               String      @id @default(cuid())
  /// 출장 목적
  title            String
  status           String      @default("")
  requestOrgType   String      @default("")
  /// 요청처
  requestOrg       String      @default("")
  siteContact      String      @default("")
  address          String      @default("")
  /// 시·도 (null = 미지정)
  region           String?
  /// 시·군·구 (null = 미확인)
  sigungu          String?
  /// 출장 시작일 — 집계 기준일. 없으면 어느 기간에도 넣지 않음
  tripStart        DateTime?   @db.Date
  tripEnd          DateTime?   @db.Date
  extraTrip        String      @default("")
  authorName       String      @default("")
  writtenAt        DateTime?
  happyCallDate    DateTime?   @db.Date
  workType         String      @default("")
  faultDescription String      @default("")
  workDescription  String      @default("")
  workResult       String      @default("")
  billing          SvcBilling?
  quoteType        String      @default("")
  quote            String      @default("")
  approver         String      @default("")
  cc               String      @default("")
  note             String      @default("")

  companions  SvcReportCompanion[]
  products    SvcReportProduct[]
  parts       SvcReportPart[]
  attachments SvcReportAttachment[]

  /// 숨김(삭제 대신) — 대시보드·목록·메인 집계에서 빠짐
  deletedAt   DateTime?
  deletedById String?

  createdById String
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tripStart])
  @@index([region, sigungu])
  @@index([deletedAt])
  @@map("svc_report")
}

/// 동행자
model SvcReportCompanion {
  id       String    @id @default(cuid())
  reportId String
  report   SvcReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name     String

  @@index([reportId])
  @@map("svc_report_companion")
}

/// 제품 목록 (수량은 선택 — PDF에 없음)
model SvcReportProduct {
  id        String    @id @default(cuid())
  reportId  String
  report    SvcReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  modelName String
  spec      String    @default("")
  serialNo  String    @default("")
  quantity  Int?

  @@index([reportId])
  @@map("svc_report_product")
}

/// 교체 부품 — 가격은 출장지마다 달라 SvcSitePartPrice 에 따로 둔다
model SvcPart {
  id   String @id @default(cuid())
  name String @unique
  note String @default("")

  usages     SvcReportPart[]
  sitePrices SvcSitePartPrice[]

  deletedAt   DateTime?
  deletedById String?
  createdById String
  updatedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("svc_part")
}

/// 출장지 — 이름이 출장보고서 요청처(requestOrg)와 같은 글자여야 보고서와 연결된다
model SvcSite {
  id      String  @id @default(cuid())
  name    String  @unique
  region  String?
  sigungu String?
  note    String  @default("")

  prices SvcSitePartPrice[]

  deletedAt   DateTime?
  deletedById String?
  createdById String
  updatedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("svc_site")
}

/// 출장지별 부품 가격(직접 입력, 원) — 행이 없거나 숨긴 조합 = 미입력 (다른 값으로 채우지 않음)
model SvcSitePartPrice {
  id        String  @id @default(cuid())
  siteId    String
  site      SvcSite @relation(fields: [siteId], references: [id], onDelete: Restrict)
  partId    String
  part      SvcPart @relation(fields: [partId], references: [id], onDelete: Restrict)
  unitPrice BigInt
  note      String  @default("")

  /// 숨김 = 가격 삭제(미입력). 다시 입력하면 같은 행을 되살린다
  deletedAt   DateTime?
  deletedById String?
  updatedById String
  updatedAt   DateTime  @updatedAt

  @@unique([siteId, partId])
  @@index([partId])
  @@map("svc_site_part_price")
}

/// 출장보고서의 부품 사용 내역 (수량은 PDF에 없어 선택)
model SvcReportPart {
  id       String    @id @default(cuid())
  reportId String
  report   SvcReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  partId   String
  part     SvcPart   @relation(fields: [partId], references: [id], onDelete: Restrict)
  quantity Int?
  /// 보고서 안 순서
  position Int       @default(0)

  @@unique([reportId, partId])
  @@index([partId])
  @@map("svc_report_part")
}

/// 사진·자료 첨부 — 배포 서버에 디스크가 없어 파일 내용을 DB 에 저장 (파일당 20MB 이하)
enum SvcAttachmentKind {
  ORIGINAL
  NAMEPLATE
  BEFORE_WORK
  AFTER_WORK
  BEFORE_PART
  AFTER_PART
  RELATED
}

model SvcReportAttachment {
  id           String            @id @default(cuid())
  reportId     String
  report       SvcReport         @relation(fields: [reportId], references: [id], onDelete: Restrict)
  kind         SvcAttachmentKind
  originalName String
  contentType  String
  size         Int
  /// 같은 파일(특히 원본 PDF)을 두 번 등록하지 않도록
  sha256       String
  content      Bytes

  deletedAt    DateTime?
  deletedById  String?
  uploadedById String
  uploadedAt   DateTime  @default(now())

  @@index([reportId])
  @@index([sha256])
  @@map("svc_report_attachment")
}

// ---------- 단가 (2026-11-05 — 친구 우민영 저장소 newtalk-dashboard 의 lib/pricing.js 부품 단가를 옮김) ----------
// 담당자 피드백: 뉴토크 기준값 = 단가표 기준단가 그대로(할인율·추가단가 없음), 견적서 PDF·단가 직접 입력 대신 CSV/엑셀 업로드
// 기존 부품·가격(SvcPart·SvcSite·SvcSitePartPrice)과는 따로 둔다 — 합칠지는 친구들과 정한 뒤

/// 단가표 부품 (친구 part_catalog) — 같은 부품 = 파트넘버 + 품목 (친구 UNIQUE(part_no, name) 그대로 —
/// 고객사 원본에 파트넘버가 같고 품목이 다른 줄이 있음)
model SvcPriceItem {
  id        String  @id @default(cuid())
  /// 파트넘버 원문 (화면 표시)
  partNo    String
  /// 파트넘버 비교용 — 공백·하이픈 빼고 대문자 (예: "md-05 a-01" → "MD05A01")
  partKey   String
  /// 같은 부품 판별용 = partKey + "|" + 품목(공백 빼고 대문자)
  itemKey   String  @unique
  /// 분류 (예: "05 MOTOR")
  category  String  @default("")
  /// 품목
  name      String
  /// 적용 모델 (원본 엑셀 "적요")
  appliesTo String  @default("")
  /// 뉴토크 기준값(원, 부가세 제외) — 빈칸 = 미입력(0원과 다름)
  basePrice BigInt?
  /// 원본 순서 (업로드한 파일 순서, 직접 추가는 맨 뒤)
  sortOrder Int     @default(0)

  quotes SvcPriceQuote[]

  deletedAt   DateTime?
  deletedById String?
  createdById String
  updatedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([partKey])
  @@index([category])
  @@map("svc_price_item")
}

/// 출장지(업체)별 부품 단가 (친구 part_prices) — 같은 부품·같은 출장지라도 적용 시작일마다 한 줄
model SvcPriceQuote {
  id            String       @id @default(cuid())
  itemId        String
  item          SvcPriceItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  /// 출장지(업체) 이름
  company       String
  /// 단가(원, 부가세 제외)
  unitPrice     BigInt
  /// 적용 시작일 (한국 날짜)
  effectiveDate DateTime     @db.Date
  note          String       @default("")
  /// 수주 내역 CSV 의 판매번호·사업명 (2026-11-07 — 친구 저장소 quote_no·quote_project)
  quoteNo       String       @default("")
  project       String       @default("")
  /// 올린 형식: table = 양식 CSV·엑셀, order = 수주 내역 CSV
  source        String       @default("table")

  /// 숨김 = 삭제 (조회 시 반드시 deletedAt: null)
  deletedAt   DateTime?
  deletedById String?
  createdById String
  updatedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([itemId, company, effectiveDate])
  @@map("svc_price_quote")
}
