# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 git에 올리지 않는다)

# --- DB: 아래 둘 중 하나 ---
# Postgres.app (5432, 비밀번호 없음 — USER는 본인 맥 사용자명)
DATABASE_URL="postgresql://USER@localhost:5432/newtork?schema=public"
# Docker (docker compose up -d, 5433)
# DATABASE_URL="postgresql://newtork:newtork@localhost:5433/newtork?schema=public"

# --- 인증 (Better Auth) ---
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- AI (서버 전용, 클라이언트 노출 금지 — NEXT_PUBLIC_ 접두사 쓰지 말 것) ---
ANTHROPIC_API_KEY=""
