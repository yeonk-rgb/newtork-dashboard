# 이 파일을 .env 로 복사한 뒤 값을 채운다. (.env 는 git에 올리지 않는다)

# --- DB: 아래 둘 중 하나 ---
# Postgres.app (5432, 비밀번호 없음 — USER는 본인 맥 사용자명)
DATABASE_URL="postgresql://USER@localhost:5432/newtork?schema=public"
# Docker (docker compose up -d, 5433)
# DATABASE_URL="postgresql://newtork:newtork@localhost:5433/newtork?schema=public"

# --- 인증 (아이디·비밀번호 로그인, 세션은 DB에 저장 — 별도 비밀키 없음) ---
# npm run db:seed 로 만드는 직원 계정 7개의 공통 초기 비밀번호 (선택).
# 비워 두면 시드 실행 때 무작위로 만들어 화면에 한 번만 보여준다. 첫 로그인 때 변경 강제.
SEED_INITIAL_PASSWORD=""
# 최초 관리자 (배포용, 선택): 둘 다 있으면 시드 때 이 관리자를 먼저 만든다. 첫 로그인 때 변경 강제
# 아이디는 영문 소문자·숫자·밑줄 3~30자, 비밀번호는 8자 이상
INITIAL_ADMIN_ID=""
INITIAL_ADMIN_PASSWORD=""

# --- AI (서버 전용, 클라이언트 노출 금지 — NEXT_PUBLIC_ 접두사 쓰지 말 것) ---
# 키는 직접 쓰지 말고 `npm run env:set-key` 로 넣는다 (입력 숨김, 길이만 표시)
ANTHROPIC_API_KEY=""
# 키 없이 화면 확인용 모의 응답 (개발 서버에서만 동작, 배포 빌드에서는 무시)
AI_MOCK=""
# 배포 서버(next start)에서 AI 분석 허용 여부 — 외부 AI 전송 동의(05-19) 전에는 false. next dev 에는 영향 없음
AI_ALLOW_REAL_DATA="false"
