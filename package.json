{
  "name": "newtork-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:up": "docker compose up -d",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:seed": "prisma db seed",
    "db:seed:if-empty": "SEED_ONLY_IF_EMPTY=true prisma db seed",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "metrics:report": "tsx --conditions=react-server scripts/metrics-report.ts",
    "export:report": "tsx --conditions=react-server scripts/export-report.ts",
    "env:set-key": "bash scripts/set-anthropic-key.sh",
    "seed:ai-examples": "tsx --conditions=react-server scripts/seed-ai-examples.ts",
    "seed:ledger": "tsx --conditions=react-server scripts/seed-ledger.ts",
    "audit:recent": "tsx --conditions=react-server scripts/audit-recent.ts",
    "db:smoke": "tsx --conditions=react-server scripts/db-smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "exceljs": "4.4.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.2",
    "pretendard": "1.3.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "shadcn": "^4.21.5",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
